# Server-related configuration ------
API_PORT = 6500
# Comma-separated list of allowed origins
CORS_ORIGIN = http://localhost:3000
# IP or CIDR of your reverse proxy. Leave empty if there is none
TRUST_PROXY =

JWT_SECRET_KEY = <a_secret_key_for_jwt>
COOKIE_SECRET_KEY = <a_secret_key_for_cookies>

# Database connection ---------------
DB_DRIVER = postgres
DB_USER = root
DB_PASSWORD = root
DB_HOST = 127.0.0.1
DB_PORT = 5440
DATABASE = fastify-boilerplate
# Mail Service configuration -------
# 'smtp' (also for the SES SMTP interface) or 'ses' (AWS SDK)
MAIL_PROVIDER = smtp
MAIL_SENDER =
# Only for 'smtp'. Leave SMTP_USER empty if the server needs no authentication
SMTP_HOST =
SMTP_PORT = 587
SMTP_USER =
SMTP_PASS =
# Only for 'ses'
AWS_REGION =
AWS_ACCESS_KEY_ID =
AWS_SECRET_ACCESS_KEY =

# Redis connection ------------------
REDIS_USER =
REDIS_PASSWORD = 
REDIS_HOST = 127.0.0.1
REDIS_PORT = 6379
REDIS_DB_NUMBER = 0

# Seeder ----------------------------
# Needs 8+ chars with uppercase, lowercase and a number
SEED_ADMIN_PASSWORD =
